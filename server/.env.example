# 复制为 server/.env 后填写；.env 不要提交到仓库。
# 任何兼容 OpenAI chat/completions 且支持图片的模型都可以。
# 下面以阿里云百炼为例，模型名以控制台的模型列表为准。
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MODEL=qwen-vl-plus

PORT=8787
# 每个来源每分钟、全服务每天的识别次数上限，用来控制费用。
RATE_PER_MINUTE=20
DAILY_LIMIT=500
# 部署在网关或云托管之后时设为 1，否则所有用户会被当成同一来源。
TRUST_PROXY=0
# 仅 H5 调试需要，小程序不走跨域。
ALLOWED_ORIGIN=
